# Test image for agent-first-http.
#
# Built on top of rust:trixie (Debian 13 + recent stable Rust) so the spore's
# build/test/clippy cycle runs in a container with chromium preinstalled
# instead of polluting the host with browser packages and chromiumoxide native deps.
#
# Usage is via tests/run-in-container.sh (which builds from this file with the
# spore root as the build context). Source is mounted as a volume; cargo registry
# + target dirs live in named volumes so iteration is fast.

FROM rust:trixie

ENV DEBIAN_FRONTEND=noninteractive

# Chromium + the runtime deps it needs to start. Build deps cover everything
# chromiumoxide / aws-lc-rs / axum / openssl-sys / etc. transitively pull in
# during compilation.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        chromium \
        chromium-driver \
        clang \
        cmake \
        curl \
        fonts-liberation \
        fonts-noto-cjk \
        git \
        jq \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libclang-dev \
        libdrm2 \
        libgbm1 \
        libnss3 \
        libssl-dev \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        matchbox-window-manager \
        pkg-config \
        procps \
        unzip \
        xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Browser backends — installed from the single source of truth shared with the
# runtime image (container/docker/install-backends.sh), so pinned versions can
# never drift between the test image and the deploy image. Every backend
# installed here is required at run time (tests/container-entrypoint.sh extends
# AFHTTP_TEST_REQUIRE_BACKENDS), so its tests fail rather than skip when the
# binary is missing. Only the very large camoufox backend is opt-in, and only
# its tests self-skip when the image was built without it.
COPY container/docker/install-backends.sh /usr/local/bin/install-backends.sh
ARG AFHTTP_TEST_INSTALL_CAMOUFOX=0
RUN chmod +x /usr/local/bin/install-backends.sh \
    && install-backends.sh lightpanda \
    && install-backends.sh fingerprint-chromium \
    && if [ "$AFHTTP_TEST_INSTALL_CAMOUFOX" = "1" ]; then install-backends.sh camoufox; else echo "skipping camoufox in test image; set AFHTTP_TEST_INSTALL_CAMOUFOX=1 to include it"; fi \
    && install-backends.sh chrome \
    && install-backends.sh brave \
    && install-backends.sh kasmvnc

# Same managed policy as the runtime image, so a takeover test sees the same
# browser chrome a deployed host does.
COPY container/docker/install-browser-policy.sh /usr/local/bin/install-browser-policy.sh
RUN chmod +x /usr/local/bin/install-browser-policy.sh \
    && install-browser-policy.sh

# Cargo caches live on named volumes so image rebuilds do not redownload crates.
ENV CARGO_HOME=/cargo-home \
    CARGO_TARGET_DIR=/cargo-target \
    AFHTTP_TEST_REQUIRE_BACKENDS=chromium \
    AFHTTP_TEST_INSTALL_CAMOUFOX=${AFHTTP_TEST_INSTALL_CAMOUFOX} \
    AFHTTP_TEST_BROWSER_BIN=/usr/bin/chromium \
    AFHTTP_TEST_LIGHTPANDA_BIN=/usr/local/bin/lightpanda \
    AFHTTP_TEST_FINGERPRINT_CHROMIUM_BIN=/usr/local/bin/fingerprint-chromium \
    AFHTTP_TEST_FOXBRIDGE_BIN=/usr/local/bin/foxbridge \
    AFHTTP_TEST_CAMOUFOX_BIN=/usr/local/bin/camoufox \
    AFHTTP_TEST_CHROME_BIN=/usr/bin/google-chrome-stable \
    AFHTTP_TEST_BRAVE_BIN=/usr/bin/brave-browser \
    AFHTTP_TEST_KASMVNC_BIN=/usr/bin/Xvnc \
    AFHTTP_KASMVNC_BIN=/usr/bin/Xvnc \
    AFHTTP_KASMVNC_WEB_ROOT=/usr/share/kasmvnc/www \
    AFHTTP_NO_SANDBOX=1 \
    RUST_BACKTRACE=1

RUN rustup component add clippy rustfmt

WORKDIR /work

COPY tests/container-entrypoint.sh /usr/local/bin/test-entrypoint.sh
RUN chmod +x /usr/local/bin/test-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/test-entrypoint.sh"]
